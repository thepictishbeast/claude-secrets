#!/bin/sh
# claude-secrets — sovereign secrets manager for AI agent workflows
#
# Stack: age (Rust impl rage / Go impl age, both interoperable).
# Storage: ~/.claude-secrets/ — local-first, never in any cloud / KMS.
#
# Subcommands:
#   init          generate an age key pair (idempotent — refuses to clobber)
#   put NAME      encrypt stdin to ~/.claude-secrets/store/NAME.age
#   get NAME      decrypt and print to stdout
#   list          list stored secret names (no values, no contents)
#   rm NAME       delete a stored secret
#   ref NAME      print a reference token safe to embed in chat / configs
#   pubkey        print the public-key recipient string
#   audit [N]     show last N audit-log lines (default 20)
#   hygiene CMD   find reused / unrotated credentials on this host (root;
#                 see hygiene/README.md) — never stores or prints one
#
# Every read/write is appended to ~/.claude-secrets/audit.log (mode 600).
set -eu

DIR="${CLAUDE_SECRETS_DIR:-$HOME/.claude-secrets}"
KEY="$DIR/key.txt"
PUB="$DIR/identity.pub"
STORE="$DIR/store"
LOG="$DIR/audit.log"

ensure_dir() {
    if [ ! -d "$DIR" ]; then
        mkdir -p "$DIR"
        chmod 700 "$DIR"
    fi
    if [ ! -d "$STORE" ]; then
        mkdir -p "$STORE"
        chmod 700 "$STORE"
    fi
    [ -f "$LOG" ] || { : > "$LOG"; chmod 600 "$LOG"; }
}

audit() {
    # $1 = action verb, $2 = name (or - if none)
    printf '%s %s %s pid=%d uid=%d\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$$" "$(id -u)" \
        >> "$LOG"
}

die() {
    echo "claude-secrets: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF' >&2
usage: claude-secrets <subcommand> [args]
  init                  generate age key pair (idempotent)
  put NAME              encrypt stdin → store NAME
  get NAME              decrypt NAME → stdout
  list                  list stored secret names
  rm NAME               delete stored secret NAME
  ref NAME              print ${SECRET:NAME} reference token
  pubkey                print this host's public recipient
  audit [N]             tail last N audit log lines (default 20)
  hygiene check|scan    reused / unrotated credentials on this host (root)
EOF
    exit 2
}

# Identity validation: ensure the secret name is filesystem-safe and not
# trying to escape the store directory. Names: [a-zA-Z0-9._-]+ only.
validate_name() {
    case "$1" in
        ''|.|..) die "invalid name: empty or relative" ;;
        */*) die "invalid name: no path separators" ;;
        *[!a-zA-Z0-9._-]*) die "invalid name: only [a-zA-Z0-9._-] allowed" ;;
    esac
}

cmd_init() {
    ensure_dir
    if [ -f "$KEY" ]; then
        die "key already exists at $KEY (refusing to clobber; rm manually first if you know what you're doing)"
    fi
    age-keygen -o "$KEY" 2>/dev/null
    chmod 600 "$KEY"
    grep -oE '^# public key: \S+' "$KEY" | awk '{print $4}' > "$PUB"
    chmod 644 "$PUB"
    audit init -
    echo "Generated age key pair."
    echo "  private: $KEY (mode 600)"
    echo "  public:  $PUB (mode 644)"
    echo "  recipient: $(cat "$PUB")"
}

cmd_pubkey() {
    [ -f "$PUB" ] || die "no public key yet — run: claude-secrets init"
    cat "$PUB"
}

cmd_put() {
    [ $# -eq 1 ] || die "put requires exactly one NAME argument"
    validate_name "$1"
    [ -f "$PUB" ] || die "no public key — run: claude-secrets init"
    ensure_dir
    age -e -r "$(cat "$PUB")" -o "$STORE/$1.age"
    chmod 600 "$STORE/$1.age"
    audit put "$1"
    echo "stored: $1"
}

cmd_get() {
    [ $# -eq 1 ] || die "get requires exactly one NAME argument"
    validate_name "$1"
    [ -f "$KEY" ] || die "no private key — run: claude-secrets init"
    [ -f "$STORE/$1.age" ] || die "no such secret: $1"
    audit get "$1"
    age -d -i "$KEY" "$STORE/$1.age"
}

cmd_list() {
    [ -d "$STORE" ] || { echo "(no secrets stored)" >&2; return 0; }
    for f in "$STORE"/*.age; do
        [ -e "$f" ] || { echo "(no secrets stored)" >&2; return 0; }
        name="$(basename "$f" .age)"
        mtime="$(stat -c '%y' "$f" 2>/dev/null | cut -d. -f1)"
        size="$(stat -c '%s' "$f" 2>/dev/null)"
        printf '%-30s %s  %sB\n' "$name" "$mtime" "$size"
    done
    audit list -
}

cmd_rm() {
    [ $# -eq 1 ] || die "rm requires exactly one NAME argument"
    validate_name "$1"
    [ -f "$STORE/$1.age" ] || die "no such secret: $1"
    rm -- "$STORE/$1.age"
    audit rm "$1"
    echo "removed: $1"
}

cmd_ref() {
    [ $# -eq 1 ] || die "ref requires exactly one NAME argument"
    validate_name "$1"
    # NOTE: this command does NOT verify the secret exists. It's a pure
    # text-formatting convenience so chat / configs can reference secrets
    # by handle without leaking values.
    # shellcheck disable=SC2016  # literal output, no shell expansion intended
    printf '${SECRET:%s}\n' "$1"
}

cmd_audit() {
    [ -f "$LOG" ] || { echo "(no audit log yet)" >&2; return 0; }
    n="${1:-20}"
    case "$n" in
        ''|*[!0-9]*) die "audit count must be an integer" ;;
    esac
    tail -n "$n" "$LOG"
}

cmd_hygiene() {
    bin="${CLAUDE_SECRETS_HYGIENE:-/usr/local/bin/claude-secrets-hygiene}"
    [ -x "$bin" ] || die "hygiene is not installed (build hygiene/ and install to $bin)"
    # It reads every credential on the host to fingerprint it, and its
    # pepper and state are root-only, so it runs as root or not at all.
    [ "$(id -u)" -eq 0 ] || die "hygiene runs as root: sudo claude-secrets hygiene $*"
    exec "$bin" "$@"
}

# Dispatch
[ $# -ge 1 ] || usage
sub="$1"
shift
case "$sub" in
    init)   cmd_init "$@" ;;
    put)    cmd_put "$@" ;;
    get)    cmd_get "$@" ;;
    list)   cmd_list "$@" ;;
    rm)     cmd_rm "$@" ;;
    ref)    cmd_ref "$@" ;;
    pubkey) cmd_pubkey "$@" ;;
    audit)  cmd_audit "$@" ;;
    hygiene) cmd_hygiene "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown subcommand: $sub (run 'claude-secrets help')" ;;
esac
