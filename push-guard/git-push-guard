#!/usr/bin/env bash
# git-push-guard — refuse a push until its destination's visibility is known
# and its outgoing commits are clean. Runs as git's pre-push hook:
#
#   git-push-guard <remote-name> <remote-url>   (stdin: pre-push ref lines)
#
# Every push, private or public, is refused if the outgoing commits contain:
#   - a known credential, in any leaked form (claude-secrets-hygiene find-in,
#     reached through the root push-scan socket so paul's pushes are covered)
#   - anything gitleaks recognises
#   - a newly added credential-shaped file (.env, private keys, keystores,
#     databases)
# A push to a PUBLIC repository is refused unless the destination is listed in
# /etc/claude-secrets/public-push-allow. Publishing is a judgement the scans
# cannot make and a wrong guess is permanent, so an unlisted public
# destination is refused rather than guessed at. It is also refused if an
# added line or a commit message matches /etc/claude-secrets/public-denylist
# (personal data, internal addresses, credential locations).
#
# Any push, public or private, is refused if it adds or changes a licence file
# carrying an express patent grant (Apache-2.0 s3, GPL/AGPL-3.0 s11, MPL-2.0
# s2.1, FSL Patents), because that grant reaches every recipient and cannot be
# withdrawn later.
#
# Visibility comes from the GitHub API. If it cannot be confirmed, the push
# is refused: an unknown answer is treated as public and unsafe.
# Output names labels, rules, commits and files, never a matched value.
#
# The only way past a refusal is a person running `git push --no-verify`
# themselves; Claude sessions are denied that flag by their own hook.
set -uo pipefail

remote="${1:-}"
url="${2:-}"
DENYLIST=/etc/claude-secrets/public-denylist
ALLOW=/etc/claude-secrets/push-allow
ALLOW_PUBLIC=/etc/claude-secrets/public-push-allow
SOCKET=/run/push-scan.sock
ZERO=0000000000000000000000000000000000000000
problems=()
# What to do about a refusal. Rewriting commits is the answer for content the
# scans caught; it is no answer at all when the destination itself is the
# problem, so that case replaces this.
fix_hint="Fix the commits (rewrite them if they are unpushed), then push again."

say() { printf 'push-guard: %s\n' "$*" >&2; }
refuse() {
  say "REFUSED push to ${url}"
  for p in "${problems[@]}"; do say "  - $p"; done
  say "$fix_hint"
  exit 1
}

# ---- 1. Where is this going, and is it public? ----------------------------
slug=""
case "$url" in
  *github.com[:/]*)
    slug=$(printf '%s' "$url" | sed -E 's#^.*github\.com[:/]+##; s#\.git/?$##; s#/+$##')
    if ! private=$(gh api "repos/${slug}" --jq '.private' 2>/dev/null); then
      problems+=("could not confirm whether github.com/${slug} is public or private (gh api failed); refusing rather than guessing")
      refuse
    fi
    case "$private" in
      true) visibility=private ;;
      false) visibility=public ;;
      *) problems+=("unexpected visibility answer for ${slug}"); refuse ;;
    esac
    ;;
  /* | file://* | ./* | ../*)
    # A path on this machine is private. A test or mirror remote can declare
    # itself public (stricter), never the other way round.
    visibility=private
    [ "$(git config --get push-guard.visibility 2>/dev/null)" = public ] && visibility=public
    # Tests only: a local remote may name a lab scanner socket and a lab
    # denylist, so tests never need the real private entries. Nothing that
    # leaves this machine can use these.
    lab_socket=$(git config --get push-guard.socket 2>/dev/null) && SOCKET="$lab_socket"
    lab_deny=$(git config --get push-guard.denylist 2>/dev/null) && DENYLIST="$lab_deny"
    lab_allow=$(git config --get push-guard.allowfile 2>/dev/null) && ALLOW_PUBLIC="$lab_allow"
    ;;
  *)
    # Any other host: its visibility cannot be checked, so scan as public.
    visibility=public
    ;;
esac

# Files a licence lives in, and the clauses that give away patent rights.
LICENSE_FILES='(^|/)(LICEN[SC]E|COPYING)([.-][A-Za-z0-9._-]+)?$'
# Which patent grant, if any, a licence text carries. Printed in a refusal so
# the cost of allowing a push is visible, never guessed at.
patent_grant() {
  local t=$1
  printf '%s' "$t" | /usr/bin/grep -qiE 'Grant of Patent License' && { echo 'Apache-2.0 section 3'; return; }
  printf '%s' "$t" | /usr/bin/grep -qiE '^ *11\. *Patents' && { echo 'GPL/AGPL-3.0 section 11'; return; }
  printf '%s' "$t" | /usr/bin/grep -qiE 'under (its )?Patent Claims' && { echo 'MPL-2.0 section 2.1'; return; }
  printf '%s' "$t" | /usr/bin/grep -qiE '^#+ *Patents? *$' && { echo 'FSL Patents section'; return; }
  return 1
}
# The grant carried by the licence files already committed at HEAD.
head_grant() {
  local f t g
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    t=$(git show "HEAD:$f" 2>/dev/null) || continue
    g=$(patent_grant "$t") && { printf '%s in %s' "$g" "$f"; return 0; }
  done < <(git ls-tree -r --name-only HEAD 2>/dev/null | /usr/bin/grep -E "$LICENSE_FILES")
  return 1
}

# ---- 1b. A public destination needs an explicit allowance -----------------
# The scans below answer whether this content is a secret. They cannot answer
# whether it should be published at all — that is a judgement about what is
# worth keeping unpublished, and a wrong guess is permanent: a public push
# ends patent rights in Europe and China the day it lands and starts a
# one-year US clock. So it is not guessed. A public destination must be named
# in a file only a person edits, and the push is refused otherwise.
if [ "$visibility" = public ]; then
  dest=$(printf '%s' "${slug:-$url}" | tr 'A-Z' 'a-z')
  if [ ! -r "$ALLOW_PUBLIC" ]; then
    problems+=("cannot read ${ALLOW_PUBLIC}, so no public push can be allowed; refusing")
    refuse
  fi
  if ! sed -E 's/#.*//; s/^[[:space:]]+//; s/[[:space:]]+$//; /^$/d' "$ALLOW_PUBLIC" |
       tr 'A-Z' 'a-z' | /usr/bin/grep -qxF "$dest"; then
    problems+=("${dest} is PUBLIC and is not listed in ${ALLOW_PUBLIC}")
    problems+=("a public push is permanent: it ends European and Chinese patent rights in what it discloses that same day, and starts a one-year US clock")
    g=$(head_grant) && problems+=("this repository's licence also grants every recipient a patent licence (${g})")
    fix_hint="Nothing in the commits is wrong: the destination is. Push somewhere private, or ask Paul."
    refuse
  fi
fi

# ---- 2. Which commits are leaving? ----------------------------------------
revs=()
tags=()
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$ZERO" ] && continue # a branch deletion sends no content
  # An annotated tag carries a message of its own, which leaves with it.
  [ "$lsha" != "$rsha" ] && [ "$(git cat-file -t "$lsha" 2>/dev/null)" = tag ] && tags+=("$lsha")
  if [ "$rsha" != "$ZERO" ] && git cat-file -e "${rsha}^{commit}" 2>/dev/null; then
    revs+=("${rsha}..${lsha}")
  else
    # New branch, or a remote tip we do not have: everything not already on
    # this remote. A first push to a new repo sends its whole history.
    revs+=("$lsha" "--not" "--remotes=${remote}")
  fi
done
[ ${#revs[@]} -eq 0 ] && exit 0
commits=$(git rev-list "${revs[@]}" 2>/dev/null) || { problems+=("could not list the outgoing commits"); refuse; }
[ -z "$commits" ] && [ ${#tags[@]} -eq 0 ] && exit 0
n=0; [ -n "$commits" ] && n=$(printf '%s\n' "$commits" | wc -l)
say "checking ${n} outgoing commit(s)$([ ${#tags[@]} -gt 0 ] && printf ' and %d tag(s)' ${#tags[@]}) to ${slug:-$url} (${visibility})"

# Scratch space of our own. TMPDIR may be inherited from another user (a root
# session running git as paul) and be unwritable; a scan that cannot write
# its files must refuse the push, never pass it.
work=$(mktemp -d /tmp/push-guard.XXXXXX 2>/dev/null) || { problems+=("cannot create a scratch directory in /tmp; refusing"); refuse; }
trap 'rm -rf "$work"' EXIT
export TMPDIR="$work"
report="$work/gitleaks.json"
glog="$work/gitleaks.log"
added="$work/added.tsv"

# A merge is read against its first parent. git log -p shows a merge no diff
# at all, so text the merge itself adds (a conflict resolution, or anything
# neither parent has) would otherwise reach no scan.
MERGES=--diff-merges=first-parent
# git log --stdin with no input falls back to HEAD: give it only real lists.
outgoing() { [ -n "$commits" ] || return 0; printf '%s\n' "$commits" | git log --no-walk=unsorted --stdin "$@"; }
tagtext() { local t; for t in "${tags[@]}"; do printf 'tag %s\n' "$t"; git cat-file tag "$t" | sed '1,/^$/d'; done; }
patch() { outgoing -p "$MERGES" --no-color --format='commit %H%n%B' && tagtext; }

# ---- 3. Known credentials, by value (root scanner over a socket) ---------
scan=$(patch | python3 -c '
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(120)
try:
    s.connect(sys.argv[1])
except OSError as e:
    print("CONNECT-FAILED", e); sys.exit(0)
for chunk in iter(lambda: sys.stdin.buffer.read(65536), b""):
    s.sendall(chunk)
s.shutdown(socket.SHUT_WR)
out = b"".join(iter(lambda: s.recv(65536), b""))
sys.stdout.write(out.decode(errors="replace"))
' "$SOCKET")
summary=$(printf '%s\n' "$scan" | /usr/bin/grep -E 'known credential' | tail -1)
if [ -z "$summary" ]; then
  problems+=("the known-credential scan did not run ($(printf '%s' "$scan" | head -c 160 | tr '\n' ' ')); refusing rather than skipping it")
elif ! printf '%s' "$summary" | /usr/bin/grep -qE ': 0 occurrence'; then
  labels=$(printf '%s\n' "$scan" | /usr/bin/grep -oE 'cred-[0-9a-f]{6}' | sort -u | tr '\n' ' ')
  problems+=("known credential(s) in the outgoing commits: ${labels:-see scanner}(rotate them; they are in the diff)")
fi

# ---- 4. Pattern secrets (gitleaks over exactly these commits) ------------
# "${revs[*]}" joins with single spaces. A trailing space made gitleaks hand
# git an empty argument, scan 0 commits and report "no leaks found" with exit
# 0, so the number of commits it scanned is checked as well as its verdict.
if [ -n "$commits" ]; then
  if ! gitleaks git --no-banner --redact=100 --ignore-gitleaks-allow --max-decode-depth 0 \
       --log-opts="$MERGES ${revs[*]}" -f json -r "$report" . >/dev/null 2>"$glog"; then
    if [ -s "$report" ] && jq -e 'length > 0' "$report" >/dev/null 2>&1; then
      while IFS= read -r line; do problems+=("gitleaks: ${line}"); done < <(jq -r '.[] | "\(.RuleID) in \(.File) (commit \(.Commit[0:8]))"' "$report" | sort -u | head -20)
    else
      problems+=("gitleaks could not scan the outgoing commits; refusing rather than skipping it")
    fi
  fi
  # gitleaks counts only the commits that give it text to scan: a file that
  # is not binary and not deleted, with at least one hunk. An empty commit,
  # or one that only deletes, renames, or changes a mode or a binary, has
  # none. The count it must reach is worked out the same way, from the diff
  # git gives gitleaks.
  outgoing -p -U0 "$MERGES" --no-color --format='commit %H' > "$work/u0.patch" ||
    problems+=("could not read the outgoing changes; refusing")
  want=$(awk '
    function done_file() { if (infile && hunk && !del && !bin) has[c] = 1; infile = 0 }
    /^commit [0-9a-f]+$/ { done_file(); c = $2; next }
    /^diff --git / { done_file(); infile = 1; hunk = 0; del = 0; bin = 0; next }
    infile && /^deleted file mode / { del = 1; next }
    infile && /^Binary files .* differ$/ { bin = 1; next }
    infile && /^@@ / { hunk = 1; next }
    END { done_file(); k = 0; for (x in has) k++; print k }' "$work/u0.patch")
  scanned=$(/usr/bin/grep -oE '[0-9]+ commits scanned' "$glog" | /usr/bin/grep -oE '^[0-9]+' | tail -1)
  if [ "${scanned:-0}" -lt "${want:-$n}" ]; then
    problems+=("gitleaks scanned ${scanned:-0} of the ${want:-$n} outgoing commit(s) with text to scan; refusing rather than trusting a partial scan")
  fi
fi
# gitleaks git reads diffs, never messages: commit and tag messages are
# scanned as text, and the bytes it read are checked like the commit count.
{ outgoing --format='commit %H%n%B' && tagtext; } > "$work/text.txt" ||
  problems+=("could not read the outgoing messages; refusing")
if ! gitleaks stdin --no-banner --redact=100 --ignore-gitleaks-allow --max-decode-depth 0 \
     -f json -r "$work/text.json" < "$work/text.txt" >/dev/null 2>"$work/text.log"; then
  if [ -s "$work/text.json" ] && jq -e 'length > 0' "$work/text.json" >/dev/null 2>&1; then
    while IFS= read -r line; do problems+=("gitleaks: ${line}"); done < <(
      jq -r '.[] | "\(.RuleID)\t\(.StartLine)"' "$work/text.json" | while IFS=$'\t' read -r rule ln; do
        printf '%s in the message of %s\n' "$rule" "$(awk -v n="$ln" '/^(commit|tag) [0-9a-f]+$/ { w = $1 " " substr($2, 1, 8) } NR == n { print w; exit }' "$work/text.txt")"
      done | sort -u | head -20)
  else
    problems+=("gitleaks could not scan the messages; refusing rather than skipping it")
  fi
fi
read_bytes=$(/usr/bin/grep -oE 'scanned ~?[0-9]+ bytes' "$work/text.log" | /usr/bin/grep -oE '[0-9]+' | tail -1)
if [ "${read_bytes:-0}" -lt "$(wc -c < "$work/text.txt")" ]; then
  problems+=("gitleaks read ${read_bytes:-0} of $(wc -c < "$work/text.txt") bytes of the messages; refusing rather than trusting a partial scan")
fi

# ---- 5. Credential-shaped files added ------------------------------------
# Without renames, a file moved to a credential-shaped name counts as added.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in *.example | *.sample | *.template | *.pub | *.dist) continue ;; esac
  problems+=("credential-shaped file added: ${f}")
done < <(outgoing --diff-filter=A --no-renames "$MERGES" --name-only --format='' |
  /usr/bin/grep -E '(^|/)(\.env(\.[A-Za-z0-9_-]+)?|id_(rsa|dsa|ecdsa|ed25519)|[^/]*\.(pem|key|p12|pfx|jks|keystore|kdbx|sqlite3?|db))$' | sort -u)

# ---- 6. Things that must never be public ---------------------------------
if [ "$visibility" = public ]; then
  if [ ! -r "$DENYLIST" ]; then
    problems+=("cannot read ${DENYLIST}, so a public push cannot be checked; refusing")
  else
    allowed=""
    [ -r "$ALLOW" ] && allowed=$(awk -v s="$slug" -F'\t' '$1 == s {print $2}' "$ALLOW")
    # One row per added line or message line: commit, file, text.
    {
      for c in $commits; do
        git show --no-color --unified=0 "$MERGES" --format='%B' "$c" | awk -v c="${c:0:8}" '
          BEGIN { f = "(commit message)"; inmsg = 1 }
          /^diff --git / { inmsg = 0; next }
          /^\+\+\+ / { f = substr($0, 5); sub(/^b\//, "", f); next }
          inmsg { print c "\t" f "\t" $0; next }
          /^\+/ { print c "\t" f "\t" substr($0, 2) }'
      done
      for t in "${tags[@]}"; do
        git cat-file tag "$t" | sed '1,/^$/d' | awk -v c="${t:0:8}" '{ print c "\t(tag message)\t" $0 }'
      done
    } > "$added" || problems+=("could not collect the added lines; refusing")
    [ -f "$added" ] || problems+=("could not collect the added lines; refusing")
    while IFS=$'\t' read -r label re; do
      [ -z "$label" ] || [[ "$label" == \#* ]] && continue
      printf '%s\n' "$allowed" | /usr/bin/grep -qxF "$label" && continue
      hits=$(cut -f3- "$added" | /usr/bin/grep -cE "$re")
      [ "$hits" -eq 0 ] && continue
      # Locate with grep too: awk's regex dialect reads \b as a backspace.
      where=$(cut -f3- "$added" | /usr/bin/grep -nE "$re" | cut -d: -f1 | head -50 |
        while read -r ln; do sed -n "${ln}p" "$added" | cut -f1,2 | tr '\t' ' '; done | sort -u | head -5 | tr '\n' ';')
      problems+=("${label}: ${hits} line(s) — ${where:-see commits}")
    done < "$DENYLIST"
  fi
fi

# ---- 7. A licence that gives patent rights away --------------------------
# Adding or changing a licence carrying an express patent grant hands every
# recipient a licence to the patents covering that code, and it cannot be
# taken back from anyone who already holds a copy. Making the repository
# private afterwards does not undo it. Whatever the destination's visibility,
# that is a person's decision, so this refuses a private push too.
# Without --no-renames a licence moved into place (LICENSE.md -> LICENSE)
# shows as a rename with no added lines, so the grant it carries would reach
# no check. The same reason §5 uses it.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  addedtext=$(outgoing -p --no-renames "$MERGES" --no-color --format='' -- "$f" |
    /usr/bin/grep '^+' | /usr/bin/grep -v '^+++' | sed 's/^+//')
  g=$(patent_grant "$addedtext") &&
    problems+=("licence carrying a patent grant added or changed: ${f} (${g}) — this gives every recipient a patent licence, irrevocably")
done < <(outgoing --diff-filter=AM --no-renames "$MERGES" --name-only --format='' |
  /usr/bin/grep -E "$LICENSE_FILES" | sort -u)

[ ${#problems[@]} -gt 0 ] && refuse
say "ok: ${n} commit(s)$([ ${#tags[@]} -gt 0 ] && printf ' and %d tag(s)' ${#tags[@]}), ${visibility}, no known credentials, no gitleaks findings$([ "$visibility" = public ] && printf ', no denylisted content')"
exit 0
