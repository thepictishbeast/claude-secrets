[Unit]
Description=Credential hygiene: reused and unrotated credentials (keyed fingerprints only)
Documentation=https://github.com/thepictishbeast/claude-secrets/tree/main/hygiene

[Service]
Type=oneshot
ExecStart=/usr/local/bin/claude-secrets-hygiene scan --notify you@example.com
# 1 = findings (mailed when they change), not a failure of the unit.
SuccessExitStatus=1
Nice=10
IOSchedulingClass=idle
UMask=0077
# The report is a map of where every credential lives: it goes to the 0600
# report file and the mail, never to the group-readable journal.
StandardOutput=null
# It only reads credentials. It writes its own state, and a mail into
# postfix's maildrop when findings change.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/claude-secrets /var/spool/postfix/maildrop
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
